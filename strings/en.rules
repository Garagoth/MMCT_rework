Resources
{
	Steam = "A superheated steam from boiling water under high pressure."
	Plasma = "Contents of batteries."
}
Parts
{
	Substation = "Power Substation"
	SubstationIcon = "Substation"
	SubstationDesc = "A substation capable of inserting or pulling power out of a cable network. \n\n"\
				"Cable must connect to substation directly, otherwise all power consumers in range of 3 cells around are powered wirelessly.\n"\
				"Substations must be used to send power to nearby blocks, as cables cannot do that naturally.\n"\
				"Acts as cable as well and accepts batteries deliveried by crew."

	Substation2 = "Wireless Substation"
	Substation2Icon = "Wireless Substation"
	Substation2Desc = "A specialized form of wireless power projector capable of sending power to blocks (on the same ship) in a straight line from projector head.\n\n"\
				"Cables must be attached directly to substation to transfer power to and from substation, all battery consumers are powered wirelessly.\n"\
				"Acts as cable as well and accepts batteries deliveried by crew."
	
	DiodeConnector = "One-way cable connector"
	DiodeConnectorIcon = "Connector"
	DiodeConnectorDesc = "A specialized cable connector that works only one way, like a diode.\n\n"\
				"Connects to any two things that cable and substation can and transports power from one to another.\n"\
				"Can extract power directly from reactors and capacitors."

	ConnectorExtender = "Connector extender"
	ConnectorExtenderIcon = "Connector extender"
	ConnectorExtenderDesc = "Connector extender. Passive element, acts as splitter/joiner allowing connector to pull or push into multiple adjacent storages. Has up and down. WIP."

	PowerStorageDesc = "Stores a limited cache of plasma batteries that may be used by nearby ship's systems or pushed to a cables attached.\n"\
				"Will equalize power with other capacitors attached directly."
	
	Cable = "Cable (Corridor)"
	CableIcon = "Cable (Corridor)"
	CableDesc = "A length of cable that runs through a corridor, the thinner floor plate means crew have to be more careful walking over it. These transmit power from substations or capacitors to substations.\n\n"\
				"Cables do not deliver power directly to parts, and must deliver to a substation next to those parts. Cables must connect to each other to transfer power between them.\n"\
				"Can extract power from attached capacitors directly."
	
	CableAR1 = "Cable (Armor 1x1)"
	CableAR2 = "Cable (Armor 1x2)"
	CableARIcon = "Cable (Armor)"
	CableARDesc = "A length of cable that runs through some armor, reducing the ability to absorb damage. These transmit power from substations or capacitors to substations.\n\n"\
				"Cables do not deliver power directly to parts, and must deliver to a substation next to those parts."\
				"Can extract power from attached capacitors directly."

	ReactorCore = "Modular Reactor Core"
	ReactorCoreIcon = "Nuclear Core"
	ReactorCoreDesc = "Controlled fission of enriched uranium allows the reactor to heat up water into steam, which can then be sent via pipes to systems capable of using it."
	
	HeatSteamBoiler = "Steam Boiler"
	HeatSteamBoilerIcon = "Steam Boiler"
	HeatSteamBoilerDesc = "Boiler that converts heat (delivered via heatpipes) into steam. Excess heat is transferred to the heatpipe port on right side.\n"\
				"Make sure to connect main heat input to big heatpipe; small heatpipes have low capacity and usually are used to transport excess heat to different heat network.\n"\
				"More effective heat to steam conversion then its smaller version. Steam can be sent via pipes to systems capable of using it.\n"\
				"Includes build-in networked heat storage.\n"\
				"Warning: excess heat port is output only and will actively pump excess heat to connected network!"
	HeatSteamBoilerSmall = "Small Steam Boiler"
	HeatSteamBoilerSmallIcon = "Small Steam Boiler"
	HeatSteamBoilerSmallDesc = "Boiler that converts heat (delivered via heatpipes) into steam.\n"\
				"Steam can be sent via pipes to systems capable of using it.\n"\
				"Includes build-in networked small heat storage."
	
	HeatResistor = "Heatpipe resistor"
	HeatResistorIcon = "Heatpipe resistor"
	HeatResistorDesc = "Heatpipe fragment that has resistance to heat transfer.\n"\
				"Heat will transfer from hotter side to cooler at speed depending on heat level difference, starting at 10% difference.\n"\
				"Can be used to make sure that one side always has some heat stored for use.\n"\
				"Please note that resistor has limited heat transfer capacity - at max heat difference (100% on one side, 0% full on other side) it transfers enough to saturate up to 8 radiators. "\
				"If more throughput is needed, use multiple resistors in parallel. Please note that there is a slight ramp-up time in heat transfer speed, and more importantly, "\
				"resistors split networks - ensure there is enough heat storage on heat producing side."

	Turbine = "Steam Turbine"
	TurbineIcon = "Turbine"
	TurbineDesc = "A turbine converts high pressure steam into power, this system requires active supervision to function properly, and is notably not 100% efficient.\n\n"\
				"This part is WIP and as such does not currently have all damage sprites, this will change in the future.\n"\
				"Requires attached steam pipe and at least one transformer to extract usable battery power."
	TurbineHeat = "Heat powered Turbine"
	TurbineDescHeat = "A turbine converts ship heat into power by boiling water and using steam to run turbines and dynamos.\n"\
				"This system requires active supervision to function properly, and is notably not 100% efficient.\n\n"\
				"This part is WIP and as such does not currently have all damage sprites or correct connector graphicd, this will change in the future.\n"\
				"Requires attached heatpipe and at least one transformer to extract usable battery power."

	ThermalLoop = "Steam-Water Loop Pipe"
	ThermalLoopIcon = "Steam Pipe"
	ThermalLoopDesc = "A pair of pipes that carry steam one way, and water the other way, this carries heat energy to anywhere it needs to be."
	
	ThermalLoopPass = "Steam-Water Loop Pipe (Passable)"
	ThermalLoopPassIcon = "Steam Pipe (Passable)"
	ThermalLoopPassDesc = "A pair of pipes that carry steam one way, and water the other way, this carries heat energy to anywhere it needs to be, there is a passageway across this set of pipes, for crew to cross via."
	
	Transformer = "Power Transformer"
	TransformerIcon = "Transformer"
	TransformerDesc = "A high power electrical conversion system that can feed immense amounts of power into a grid.\n"\
				"It takes power from turbine and turns it into usable power, outputting to cables, capacitors or directly into power using parts.\n\n"\
				"Connects to turbine and can power connected stuff around its head, mostly same as substations can.\n"\
				"This part is WIP and will change visually as MMCT is updated."
}

