Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/HeatSteamBoiler"
	IconNameKey = "Parts/HeatSteamBoilerIcon"
	ID = YBJ.MMCTHeatSteamBoiler
	EditorGroup = "Power"
	DescriptionKey = "Parts/HeatSteamBoilerDesc"
	Resources
	[
		[steel, 40]
		[coil, 64]
		[tristeel, 11]
	]
	AIValueFactor = 7
	TypeCategories = [modular_reactor, is_crewed, heat_management, thermal_source]
	Size = [2, 2]
	MaxHealth = 2000
	IsFlippable = true
	BlockedTravelCells
	[
		[0, 0]
        [1, 0]
		[1, 1]
	]
	ForceManhattanPathInPart = true
	AllowedDoorLocations
	[
		[0, 2]
		[-1, 1]
	]
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 64]
	}
	
	Components : ^/0/Components
	{

		IsOperational
		{
			Type = MultiToggle
			Toggles = [PowerToggle, PartCrew, ScorchedToggle, Port_HeatUp]
			Mode = All
		}

		PowerToggle
		{
			Type = UIToggle
			ToggleID = "on_off"
			Default = 1
			RequiresCommand = false
		}

		ScorchedToggle
		{
			Type = StatusToggle
			StatusType = cosmoteer.scorched
			MinStatusValue = 1
			Invert = true
		}

		CommandConsumer
		{
			Type = CommandConsumer
			OperationalToggle = PowerToggle
			CommandPoints = 1
		}

        CrewLocation1
		{
			Type = CrewLocation
			Location = [23/64, 95/64]
			Rotation = 5d
		}

        PartCrew
		{
			Type = PartCrew
			Crew = 1
			DefaultPriority = &/PRIORITIES/ControlRoom_Crew
			PrerequisitesBeforeCrewing = [PowerToggle, ScorchedToggle, Port_HeatUp]
			CrewDestinations
			[
				&../../CrewLocation1/Location
			]
			CrewLocations
			[
				CrewLocation1
			]
		}

		Port_HeatUp
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ thermal ]
            OperationalToggle = PowerToggle
            BlueprintOperationalToggle = &OperationalToggle
			RouteSource = NetworkedHeatStorageUp
			RouteEndpoint = NetworkedHeatStorageUp
			BlueprintRouteSource = BlueprintNetworkNode1
			BlueprintRouteEndpoint = BlueprintNetworkNode1
			Overlay
			{
				OverlayIcon = "ThermalPort"
				RouteLine = "Thermal"
				DrawRouteHub = false
				ConnectedEdgeIcon = "ThermalDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 217, 0, 61]
			}
		}
        Port_HeatRight
		{
			Type = NetworkPort
			Location = [1, 0]
			Direction = Right
			Types = [ thermal, thermal_out ]
            IncompatibleTypes = [ thermal_out ]
            OperationalToggle = PowerToggle
            BlueprintOperationalToggle = &OperationalToggle
			RouteSource = NetworkHeatInput
			BlueprintRouteSource = BlueprintNetworkNode2
			BlueprintRouteEndpoint = BlueprintNetworkNode2
			Overlay
			{
				OverlayIcon = "ThermalPort"
				RouteLine = "Thermal"
				DrawRouteHub = false
				ConnectedEdgeIcon = "ThermalDot"
				HighlightPartOnPrimaryConnection = true
    			PartHighlightColor = [255, 217, 0, 61]
			}
		}

        BlueprintNetworkNode1
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}
        BlueprintNetworkNode2
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
		}

        NetworkRouter
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkedHeatStorageUp, NetworkHeatOutput, 0]
						[NetworkedHeatStorageUp, NetworkHeatInput, 10]
					]
				}
			]
		}

		NetworkedHeatStorageUp
		{
			Type = NetworkResourceStore
			ResourceType = heat
			ResourceStorage = HeatStorageUp
			Categories = [ thermal_storage ]
		}

        HeatStorageUp
		{
			Type = ResourceStorage
			ResourceType = heat
			OperationalToggle = PowerToggle
			MaxResources = (6000) * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
			InitToMaxResources = 0
			IgnoreResourcesForInitToMax = true
		}

        NetworkHeatInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			Categories = [ thermal_storage ]
		}

        NetworkHeatOutput
		{
			Type = NetworkResourceOutput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			ProvidedValueRange = 0
			ProvidedValuePerResource = 1
			Categories = [ thermal_storage ]
		}

        OverflowHeatStorage
		{
			Type = ResourceConsumingStorage
			ResourceType = heat
			TriggerThreshold = 0
			ProvidedValuePerResource = (&<./Data/statuses/heat/heat.rules>/RESOURCE_TO_STATUS_RATIO)
		}
		
		HeatDistributionStorage
		{
			Type = MultiResourceStorage
			ResourceType = heat
			ResourceStorages = [NetworkHeatInput, OverflowHeatStorage]
			AddMode = InOrder
			RemoveMode = InReverseOrder
		}

        // OverflowHeatOutput
		// {
		// 	Type = ResourceConverter
		// 	FromStorage = NetworkHeatOutput
		// 	FromQuantity = 1000 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
		// 	ToStorage = HeatDistributionStorage
		// 	ToQuantity = 1000 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
		// 	Interval = 0.2
        //     OperationalToggle = PowerToggle
        //     MinToQuantityForConversion = 100 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO) //(&FromQuantity)
        //     MinFromQuantityForConversion = ceil((&../HeatStorageUp/MaxResources) * 0.9) - (&MinToQuantityForConversion)
		// }

        SteamStorage
		{
			Type = ResourceStorage
			ResourceType = battery
			MaxResources = (&../SteamGeneration/ToQuantity) * 5
			StartingResources = &MaxResources
			IncludeWhenUnderConstruction = false
		}
		
        SteamGeneration
		{
			Type = ResourceConverter
			FromStorage = NetworkHeatOutput
			FromQuantity = 1000 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO) // FIXME: Ile to jest?
			ToStorage = SteamStorage
			ToQuantity = 1500
			Interval = 0.1
            OperationalToggle = IsOperational
            MinToQuantityForConversion = (&ToQuantity) / 3
            MinFromQuantityForConversion = (&FromQuantity) / 2
		}

        ProxyHeatStorageDown : &<../thermal.rules>/ProxyHeatStorageDown
        {
            PartLocation = [1, 2]
        }

		ThermalDelivery
		{
			Type = ResourceConverter
			FromStorage = SteamStorage
			FromQuantity = 1500
			ToStorage = ProxyHeatStorageDown
			ToQuantity = 1500
			Interval = 0.1
            OperationalToggle = IsOperational
            MinToQuantityForConversion = 1500
            MinFromQuantityForConversion = 1500
		}

		BuffProvider
		{
			Type = AreaBuffProvider
			BuffType = MMCTHeat
			BuffArea = [1, 2, 1, 1]
		}

        Graphics
		{
			Type = Graphics
			Location = [1, 1]
			Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "floor.png"
						Size = [2, 2]
					}
                ]
            }
            Walls
			{
				Layer = "walls"
				DamageLevels
				[
					{
						File = "walls.png"
						Size = [2, 2]
					}
				]
			}
        }

		Dont_Draw_Pipe_Connector_Into_This_Part { Type = Graphics }
        Pipe_Right_Components
		{
			Type = ToggledComponents
			Toggle = Port_HeatRight
			Components
			{
				Pipe_Right_Graphics
				{
					Type = Graphics
					Location = [1.5, 0.5]
                    Rotation = 0d
					// OperationalToggle = IsOperational
					Floor
					{
						Layer = "doodads_low"
                        Offset = [0.25, 0]
						DamageLevels
						[
							{
								File = "pipe_right_doodad.png"
								Size = [0.5, 1]
							}
						]
					}
					WallsStencil
					{
						Layer = "walls_stencil"
						DamageLevels
						[
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_wall_stencil.png"
								Size = [1, 1]
							}
						]
					}
					Roof
					{
						Layer = "roof_doodads"
						Offset = [0, 0]
						Rotation = 90d
						DamageLevels
						[
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_33.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_66.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
						]
					}
				}
			}
		}
        Pipe_Up_Components
		{
			Type = ToggledComponents
			Toggle = Port_HeatUp
			Components
			{
				Pipe_Up_Graphics
				{
					Type = Graphics
					Location = [0.5, 0.25]
					// OperationalToggle = IsOperational
					Floor
					{
						Layer = "doodads_low"
                        DamageLevels
						[
							{
								File = "pipe_up_doodad.png"
								Size = [1, 0.5]
							}
						]
					}
					WallsStencil
					{
						Layer = "walls_stencil"
						DamageLevels
						[
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_wall_stencil.png"
								Size = [1, 1]
							}
						]
					}
					Roof
					{
						Layer = "roof_doodads"
						Offset = [0, 0]
						Rotation = 180d
						DamageLevels
						[
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_33.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
							{
								File = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_66.png"
								NormalsFile = "./Data/ships/terran/heat_pipe_adaptive/pipe_connector/pipe_connector_roof_normals.png"
								Size = [1, 1]
							}
						]
					}
				}
			}
		}

        HeatIndicator
        {
            Type = ResourceSprites
			Location = [1, 1]
			ResourceStorage = HeatStorageUp
			Layer = "lights_add"
			HasZeroResourceSprite = false
			ResourceLevels
            [
                {
					File = "heat_1.png"
					Size = [2, 2]
				}
                {
					File = "heat_2.png"
					Size = [2, 2]
				}
                {
					File = "heat_3.png"
					Size = [2, 2]
				}
                {
					File = "heat_4.png"
					Size = [2, 2]
				}
                {
					File = "heat_5.png"
					Size = [2, 2]
				}
            ]
        }

        SteamIndicator
        {
            Type = ResourceSprites
			Location = [1, 1]
			ResourceStorage = SteamStorage
			Layer = "lights_add"
			HasZeroResourceSprite = false
			ResourceLevels
            [
                {
					File = "steam_1.png"
					Size = [2, 2]
				}
                {
					File = "steam_2.png"
					Size = [2, 2]
				}
                {
					File = "steam_3.png"
					Size = [2, 2]
				}
                {
					File = "steam_4.png"
					Size = [2, 2]
				}
                {
					File = "steam_5.png"
					Size = [2, 2]
				}
            ]
        }
    }
    Stats
	{
        HeatCapacity = (&~/Part/Components/HeatStorageUp/MaxResources) / (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
		MMCTThermalGeneration = 1 / (&~/Part/Components/SteamGeneration/Interval) * (&~/Part/Components/SteamGeneration/ToQuantity) / 100
		MMCTThermalCapacity = (&~/Part/Components/SteamStorage/MaxResources) / 100
		MMCTPowerBandwidth = 1/ (&~/Part/Components/ThermalDelivery/Interval) * (&~/Part/Components/ThermalDelivery/ToQuantity) / 100
	}
}