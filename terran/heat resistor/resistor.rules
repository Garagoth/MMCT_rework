Part : <./Data/ships/terran/base_part_terran.rules>/Part
{
	NameKey = "Parts/HeatResistor"
	IconNameKey = "Parts/HeatResistorIcon"
	ID = YBJ.MMCTHeatResistor
	EditorGroup = "Thermal"
	DescriptionKey = "Parts/HeatResistorDesc"
	Resources
	[
		[steel, 4]
		[coil, 2]
        [carbon, 2]
	]
	Size = [1, 1]
	IsRotateable = true
	IsFlippable = false
	SelectionPriority = 0
	MaxHealth = 1000
	TypeCategories = [ heat_management ]
	ReceivableBuffs : ^/0/ReceivableBuffs [ MMCTHeatTransfer ]
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	CrewSpeedFactor = 0

    RADIATOR_MAX_SCORE = (&<./Data/ships/terran/radiator/radiator.rules>/Part/Components/DissipationScore/MAX_SCORE)

	EditorIcon
	{
		Texture
		{
			File = "opornik 1.png"
			SampleMode = Linear
		}
		Size = [32, 32]
	}
	Components : ^/0/Components
	{
		Port_Up
		{
			Type = NetworkPort
			Location = [0, 0]
			Direction = Up
			Types = [ thermal ]
			RouteSource = NetworkNodeUp
			RouteEndpoint = NetworkNodeUp
			BlueprintRouteSource = NetworkNodeUp
			BlueprintRouteEndpoint = NetworkNodeUp
			Overlay
			{
				OverlayIcon = "ThermalPort"
				IconDrawMode = Never
				RouteDrawMode = Connected
				RouteLine = "Thermal"
				DrawRouteHub = false
			}
		}
		Port_Down : Port_Up
		{
			Direction = Down
            RouteSource = NetworkNodeDown
			RouteEndpoint = NetworkNodeDown
			BlueprintRouteSource = NetworkNodeDown
			BlueprintRouteEndpoint = NetworkNodeDown
		}
        NetworkNodeUp
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
            IncludeInPhysical = true
		}
        NetworkNodeDown
		{
			Type = NetworkBasicNode
			IncludeInBlueprints = true
            IncludeInPhysical = true
		}
        PortUpOutput
		{
			Type = NetworkResourceOutput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			Categories = [ thermal_storage ]
		}
        PortUpInput
		{
			Type = NetworkResourceInput
			ResourceType = heat
			Mode = DistributeProportionallyByAvailable
			Categories = [ thermal_storage ]
		}
        PortDownOutput : PortUpOutput {}
        PortDownInput : PortUpInput {}

        NetworkRouter
		{
			Type = NetworkRouter
			RouteGenerators
			[
				{
					Type = Bidirectional
					Routes
					[
						[NetworkNodeUp, PortUpOutput, 0]
                        [NetworkNodeUp, PortUpInput, 0]
                        [NetworkNodeDown, PortDownOutput, 0]
                        [NetworkNodeDown, PortDownInput, 0]
					]
				}
            ]
        }

        HeatUpDownDiff
        {
            Type = ValueOperation
			Operator = Subtract
			ValueOne = PortUpOutput
			ValueTwo = PortDownOutput
        }

        PumpFromUpToggle
        {
            Type = ThresholdToggle
            ValueFrom = HeatUpDownDiff
            MinAmount = 0.1
        }
        PumpFromDownToggle
        {
            Type = ThresholdToggle
            ValueFrom = HeatUpDownDiff
            MaxAmount = -0.1
        }

        HeatUpDownMultiplier
        {
            Type = ValueLerp
            InputValue = HeatUpDownDiff
            InputRange = [-1.0, 1.0]
            OutputRange = [-4 * (&~/Part/RADIATOR_MAX_SCORE), 4 * (&~/Part/RADIATOR_MAX_SCORE)]
        }
        HeatMultiplierAbs
        {
            Type = MultiValue
            Values = [ HeatUpDownMultiplierSmoothed ]
            Mode = Add
            Abs = true
        }
        PumpMoreBuffFromDown
		{
			Type = SelfBuffProvider
            OperationalToggle = PumpFromDownToggle
			BuffType = MMCTHeatTransfer
			BuffAmount = 1
			BuffMultiplier = PumpQuantityClampedFromDown
		}
        PumpMoreBuffFromUp
		{
			Type = SelfBuffProvider
            OperationalToggle = PumpFromUpToggle
			BuffType = MMCTHeatTransfer
			BuffAmount = 1
			BuffMultiplier = PumpQuantityClampedFromUp
		}

        HeatUpDownMultiplierSmoothed
        {
            Type = SmoothedValue
            ValueSource = HeatUpDownMultiplier
            MaxDelta = (&~/Part/RADIATOR_MAX_SCORE) / 2
            Deterministic = false
        }
        // PumpUpAvailable
        // {
        //     Type = PolledValue
        //     ValueSource = { ID = PortUpOutput; ValueID = "Resources" } // Does not work - no "Resources" available in NetworkResourceStorage
        // }
        PumpUpCapacity
        {
            Type = PolledValue
            ValueSource = { ID = PortUpInput; ValueID = "RemainingCapacity" }
        }
        PumpDownCapacity
        {
            Type = PolledValue
            ValueSource = { ID = PortDownInput; ValueID = "RemainingCapacity" }
        }
        PumpQuantityClampedFromUp
        {
            Type = MultiValue
            Values = [HeatMultiplierAbs, PumpDownCapacity]
            Mode = Min
        }
        PumpQuantityClampedFromDown
        {
            Type = MultiValue
            Values = [HeatMultiplierAbs, PumpUpCapacity]
            Mode = Min
        }

        HeatPumpFromUp
		{
			Type = ResourceConverter
			OperationalToggle = PumpFromUpToggle
			From [{
                Storage = PortUpOutput
                MinQuantityForConversion = 550 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
                Quantity {
                    BaseValue = 1
                    BuffType = MMCTHeatTransfer
                    BuffMode = Multiply
                }
            }]
            // FromStorage = PortUpOutput
			// MinFromQuantityForConversion = 1
			// FromQuantity {
            //     BaseValue = 1 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
            //     BuffType = MMCTHeatTransfer
            //     BuffMode = Multiply
            // }
            ToStorage = PortDownInput
            ToQuantity = &From/0/Quantity
			Interval = 0.1
		}
        HeatPumpFromDown
		{
			Type = ResourceConverter
			OperationalToggle = PumpFromDownToggle
			FromStorage = PortDownOutput
            ToStorage = PortUpInput
			MinFromQuantityForConversion = 550 * (&<./Data/statuses/heat/heat.rules>/STATUS_TO_RESOURCE_RATIO)
			FromQuantity {
                BaseValue = 1
                BuffType = MMCTHeatTransfer
                BuffMode = Multiply
            }
            ToQuantity = &FromQuantity
			Interval = 0.1
		}

        Dont_Draw_Pipe_Connector_Into_This_Part { Type = Graphics }
        Blueprints
		{
			Type = BlueprintSprite
			File = "blueprint-opornik 1.png"
			Size = [1, 1]
		}
        Graphics
        {
            Type = Graphics
            Location = [0.5, 0.5]
            Floor
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "opornik 1.png"
						Size = [1, 1]
					}
                ]
            }
            Roof
            {
                layer = "roofs"
                DamageLevels
                [
                    {
						File = "roof opornik 1.png"
						NormalsFile = "roof normals opornik 1.png"
						Size = [1, 1]
					}
                ]
            }
        }
    }
}