HUB
{
	SituationCode = "0000"
	AllowRotation = false
}
STUB
{
	SituationCode = "0010"
}
STRAIGHT
{
	SituationCode = "1010"
}
CORNER
{
	SituationCode = "0110"
}
SPLIT_3WAY
{
	SituationCode = "1110"
}
SPLIT_4WAY
{
	SituationCode = "1111"
	AllowRotation = false
}

BASE_BLEND_SPRITES
{
	Type = ToggledBlendSprites
	Location = [0.5, 0.5]
	SituationToggles
	[
		// Draw_Cable_Connector_Up
		// Draw_Cable_Connector_Right
		// Draw_Cable_Connector_Down
		// Draw_Cable_Connector_Left
		Port_Up
		Port_Right
		Port_Down
		Port_Left
	]
}

FloorBlendSprites : BASE_BLEND_SPRITES
{
	// Possible layers: asteroid asteroid_roof_lights_fancy construction construction_delta doodads_high doodads_low doors external_walls fire floors indicators lights_add roof_doodads roof_lights_fancy roofs roof_turrets structure structure_construction turrets walls walls_stencil weapons
	Layer = "doodads_low"
	AmbiguousSprites
	[
		: ~/HUB
		{
			DamageLevelSprites
			[
				{
					File = "img/hub/hub 1.png"
					Size = [1, 1]
				}
			]
		}
		: ~/STUB
		{
			DamageLevelSprites 
			[
				{
					File = "img/stub/stub 2.png"
					Size = [1, 1]
				}
			]
		}
		: ~/STRAIGHT
		{
			DamageLevelSprites
			[
				{
					File = "img/straight/straight 13.png"
					Size = [1, 1]
				}
			]
		}
		: ~/CORNER
		{
			DamageLevelSprites
			[
				{
					File = "img/corner/corner 6.png"
					Size = [1, 1]
				}
			]
		}
		: ~/SPLIT_3WAY
		{
			DamageLevelSprites
			[
				{
					File = "img/3way/3way 1.png"
					Size = [1, 1]
				}
			]
		}
		: ~/SPLIT_4WAY
		{
			DamageLevelSprites
			[
				{
					File = "img/4way/4way 2.png"
					Size = [1, 1]
				}
			]
		}
	]
}

IndicatorBlendUpS : BASE_BLEND_SPRITES
{
	Layer = "lights_add"
	OperationalToggle = BatteryStorageUp
	AmbiguousSprites
	[
		: ~/HUB	{ DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
		: ~/STUB { DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
		: ~/STRAIGHT { DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
		: ~/CORNER { DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
		: ~/SPLIT_3WAY { DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
		: ~/SPLIT_4WAY { DamageLevelSprites [ {File = "img/lights/status lights 2.png"; Size = [32/64, 32/64]} ] }
	]
}
