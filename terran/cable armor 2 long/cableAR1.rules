Part : <./Data/ships/terran/base_part_terran.rules>/Part
       <../cables.rules>/Part
{
	NameKey = "Parts/CableAR2"
	IconNameKey = "Parts/CableArIcon"
	ID = YBJ.MMCTCableAR1 // Part IDs must always be in the form of "author_name.part_name". If making your own mod, do *not* use "cosmoteer" as your author name, because it may conflict with future vanilla parts.
	EditorGroups = ["Defenses", "Power"]
	EditorReplacementPartID = YBJ.MMCTCableAR
	DescriptionKey = "Parts/CableARDesc"
	Resources
	[
		[steel, 16]
		[coil, 4]
	]
	AIValueFactor = 0
	Size = [2, 1]
	// FlipHRotate = [0, 1, 2, 3] // Disable flipping UI.
	// FlipVRotate = [0, 1, 2, 3] // Disable flipping UI.
	SelectionTypeID = "armor"
	MaxHealth = 6600
	ExplosiveDamageAbsorption = 100%
	ExplosiveDamageResistance = 50%
	DamageResistances
	{
		explosive = 50%
		thermal = -25%
	}
	TypeCategories = [armor, cable, non_flammable]
	// ReceivableBuffs : ^/0/ReceivableBuffs [MMCTCableCable, MMCTCableReceptor]
	ReceivableBuffs : [MMCTCableCable]
	Flammable = false
	InitialPenetrationResistance = 7
	ContinuingPenetrationResistance = &InitialPenetrationResistance
	CreatePartPerTileWhenGrabbed = ""
	CrewSpeedFactor = 0
	Density = 3
	IsRotateable = true
	IsFlippable = false
	IsWalled = true
	IsSelfDestructible = false
	AllowedDoorLocations = []
	GeneratorRequiresDoor = false
	IgnoreRotationForMirroredSelection = false
	EditorIcon
	{
		Texture
		{
			File = "icon.png"
			SampleMode = Linear
		}
		Size = [64, 32]
	}
	Components : ^/0/Components
	             ^/1/Components
	{	
		EmpAbsorber
		{
			Type = ExplosiveResourceDrainSink
			ResourceType = battery
			AbsorbsResourceDrain = 2000
			RecoveryRate = (&AbsorbsResourceDrain) * 0.1
		}

		// Cable parts overrides
        ProxyBatteryStorageRight : ^/1/ProxyBatteryStorageRight
        {
            PartLocation = [2, 0] // this part is 2x1, not 1x1
        }
		ProxyCapacitorRight : ^/1/ProxyCapacitorRight
        {
            PartLocation = [2, 0]
        }
		ProxyBatteryStorageUp2 : &ProxyBatteryStorageUp
        {
            PartLocation = [1, -1]
        }
		ProxyCapacitorUp2 : &ProxyCapacitorUp
        {
            PartLocation = [1, -1]
        }
		ProxyBatteryStorageDown2 : &ProxyBatteryStorageDown
        {
            PartLocation = [1, 1]
        }
		ProxyCapacitorDown2 : &ProxyCapacitorDown
        {
            PartLocation = [1, 1]
        }
		CombinedBatteryStorageNotUp : ^/1/CombinedBatteryStorageNotUp
        {
            ResourceStorages = [ProxyBatteryStorageDown, ProxyBatteryStorageDown2, ProxyBatteryStorageLeft, ProxyBatteryStorageRight]
        }
        CombinedBatteryStorageNotDown : ^/1/CombinedBatteryStorageNotDown
        {
            ResourceStorages = [ProxyBatteryStorageUp, ProxyBatteryStorageUp2, ProxyBatteryStorageLeft, ProxyBatteryStorageRight]
        }
        CombinedBatteryStorageNotLeft : ^/1/CombinedBatteryStorageNotLeft
        {
            ResourceStorages = [ProxyBatteryStorageUp, ProxyBatteryStorageUp2, ProxyBatteryStorageDown, ProxyBatteryStorageDown2, ProxyBatteryStorageRight]
        }
        CombinedBatteryStorageNotRight : ^/1/CombinedBatteryStorageNotRight
        {
            ResourceStorages = [ProxyBatteryStorageUp, ProxyBatteryStorageUp2, ProxyBatteryStorageDown, ProxyBatteryStorageDown2, ProxyBatteryStorageLeft]
        }
		BatteryStorageUp : ^/1/BatteryStorageUp
		{
			ResourceStorages = [RealBatteryStorageUp, ProxyCapacitorUp, ProxyCapacitorUp2]
		}
		BatteryStorageDown : ^/1/BatteryStorageDown
		{
			ResourceStorages = [RealBatteryStorageDown, ProxyCapacitorDown, ProxyCapacitorDown2]
		}

		HasProxyBatteryStorageUp2 : &ProxyBatteryStorageUp2 { Type = ComponentPresenceToggle }
		HasConnectorUp2 : &HasConnectorUp { PartLocation = &../HasProxyBatteryStorageUp2/PartLocation }
		Draw_Cable_Connector_Up2 : &Draw_Cable_Connector_Up { Toggles = [HasProxyBatteryStorageUp2, HasConnectorUp2]}
		HasProxyBatteryStorageDown2 : &ProxyBatteryStorageDown2 { Type = ComponentPresenceToggle }
		HasConnectorDown2 : &HasConnectorDown { PartLocation = &../HasProxyBatteryStorageDown2/PartLocation }
		Draw_Cable_Connector_Down2 : &Draw_Cable_Connector_Down { Toggles = [HasProxyBatteryStorageDown2, HasConnectorDown2]}
		HasProxyBatteryStorageLeft : &ProxyBatteryStorageLeft { Type = ComponentPresenceToggle }
		HasProxyBatteryStorageRight : &ProxyBatteryStorageRight { Type = ComponentPresenceToggle }
		HasConnectorRight : ^/1/HasConnectorRight {PartLocation = &../HasProxyBatteryStorageRight/PartLocation }

		Port_Up2 : &Port_Up { Location = [1, 0] }
		Port_Down2 : &Port_Down { Location = [1, 0] }
		Port_Right : ^/1/Port_Right { Location = [1, 0] }

		Graphics
		{
			Type = Graphics
			Location = [1, 0.5]
			Floor // This is needed so that armor shows up in ship ghosts.
			{
				Layer = "floors"
				DamageLevels
				[
					{
						File = "./Data/ships/terran/armor_2x1/armor.png"
						Size = [2, 1]
					}
					{
						File = "./Data/ships/terran/armor_2x1/armor_33.png"
						Size = [2, 1]
					}
					{
						File = "./Data/ships/terran/armor_2x1/armor_66.png"
						Size = [2, 1]
					}
				]
			}
			// Walls
			// {
			// 	Layer = "walls"
			// 	DamageLevels
			// 	[
			// 		{
			// 			File = "armor.png"
			// 			Size = [2, 1]
			// 		}
			// 		{
			// 			File = "armor_33.png"
			// 			Size = [2, 1]
			// 		}
			// 		{
			// 			File = "armor_66.png"
			// 			Size = [2, 1]
			// 		}
			// 	]
			// }
			Roof
			{
				Layer = "roofs"
				DamageLevels
				[
					{
						File = "roof.png"
						NormalsFile = "roof_normals.png"
						Size = [2, 1]
					}
					{
						File = "roof_33.png"
						NormalsFile = "roof_normals_33.png"
						Size = [2, 1]
					}
					{
						File = "roof_66.png"
						NormalsFile = "roof_normals_66.png"
						Size = [2, 1]
					}
				]
			}
		}

		On
		{
			Type = StaticToggle
			ToggleOn = true
		}

		FloorBlendSprites1 : &<../cable corridor/cable_corridor_blend_sprites.rules>/FloorBlendSprites
		{
			Location = [0.5, 0.5]
			SituationToggles
			[
				Port_Up
				On
				Port_Down
				Port_Left
				// Draw_Cable_Connector_Up
				// On //Draw_Cable_Connector_Right
				// Draw_Cable_Connector_Down
				// Draw_Cable_Connector_Left
			]
		}
		FloorBlendSprites2 : &<../cable corridor/cable_corridor_blend_sprites.rules>/FloorBlendSprites
		{
			Location = [1.5, 0.5]
			SituationToggles
			[
				Port_Up2
				Port_Right
				Port_Down2
				On
				// Draw_Cable_Connector_Up2
				// Draw_Cable_Connector_Right
				// Draw_Cable_Connector_Down2
				// On //Draw_Cable_Connector_Left
			]
		}

		IndicatorBlendUp : <../cable corridor/cable_corridor_blend_sprites.rules>/IndicatorBlendUpS {}
		IndicatorBlendDown : <../cable corridor/cable_corridor_blend_sprites.rules>/IndicatorBlendDownS {}
		IndicatorBlendLeft : <../cable corridor/cable_corridor_blend_sprites.rules>/IndicatorBlendLeftS {}
		IndicatorBlendRight : <../cable corridor/cable_corridor_blend_sprites.rules>/IndicatorBlendRightS {}

		DestroyedEffects
		{
			Type = DeathEffects
			MediaEffects = &/COMMON_EFFECTS/SmallPartDestroyedDry
			Location = [1, .5]
		}

		Blueprints
		{
			Type = BlueprintSprite
			File = "blueprints.png"
			Size = [2, 1]
		}
		BlueprintBlendSprites1 : &<../cable corridor/cable_corridor_blend_sprites.rules>/BlueprintBlendSprites
		{
			Location = [0.5, 0.5]
			SituationToggles
			[
				Port_Up
				On
				Port_Down
				Port_Left
			]
		}
		BlueprintBlendSprites2 : &<../cable corridor/cable_corridor_blend_sprites.rules>/BlueprintBlendSprites
		{
			Location = [1.5, 0.5]
			SituationToggles
			[
				Port_Up2
				Port_Right
				Port_Down2
				On
			]
		}
	}

	Stats : ^/1/Stats
	{
		EMPResist = (&~/Part/Components/EmpAbsorber/AbsorbsResourceDrain) / 1000
		AOEResist = (&~/Part/DamageResistances/explosive) * 100
		MMCTCableConnect = (&~/Part/Components/BuffProvider/GridDistance)
	}

}
